{
  "name": "midas-delegate-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --check --disable-nested-config",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-phantom": "0.9.30",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.40",
    "@solana/wallet-adapter-solflare": "0.6.34",
    "@solana/wallet-adapter-walletconnect": "0.1.22",
    "@solana/web3.js": "1.99.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "oxfmt": "0.48.0",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vite-plugin-node-polyfills": "0.28.0"
  },
  "resolutions": {
    "@types/react": "18.3.31"
  },
  "packageManager": "yarn@4.13.0",
  "comment": "react-native, pulled in transitively by the mobile wallet adapter, drags @types/react@19 into the tree and breaks JSX typing against React 18."
}
